# Shared development infrastructure
# Copy this tracked placeholder template to .env and keep the resulting file private.

GOFURRY_DEV_PG_HOST=<TAILNET_HOST>
GOFURRY_DEV_PG_PORT=5432

GOFURRY_DEV_PG_APP_USER=gofurry_app
GOFURRY_DEV_PG_APP_PASSWORD=CHANGE_ME

GOFURRY_DEV_REDIS_ADDR=<TAILNET_HOST>:6379
GOFURRY_DEV_REDIS_USER=gofurry_app
GOFURRY_DEV_REDIS_PASSWORD=CHANGE_ME

# Goose only
GOFURRY_GFN_MIGRATOR_URL=postgres://gofurry_migrator:CHANGE_ME@<TAILNET_HOST>:5432/gfn?sslmode=disable
GOFURRY_GFG_MIGRATOR_URL=postgres://gofurry_migrator:CHANGE_ME@<TAILNET_HOST>:5432/gfg?sslmode=disable
GOFURRY_GFA_MIGRATOR_URL=postgres://gofurry_migrator:CHANGE_ME@<TAILNET_HOST>:5432/gfa?sslmode=disable

# Managed assets - Tencent COS primary storage
GOFURRY_DEV_COS_BUCKET=gofurry-assets-dev-<APPID>
GOFURRY_DEV_COS_REGION=ap-chengdu
GOFURRY_DEV_COS_SECRET_ID=<COS_SECRET_ID>
GOFURRY_DEV_COS_SECRET_KEY=<COS_SECRET_KEY>
GOFURRY_DEV_COS_BASE_URL=https://assets-dev.go-furry.com

# Managed assets - Cloudflare R2 mirror storage
GOFURRY_DEV_R2_BUCKET=gofurry-assets-dev
GOFURRY_DEV_R2_REGION=auto
GOFURRY_DEV_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
GOFURRY_DEV_R2_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
GOFURRY_DEV_R2_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
GOFURRY_DEV_R2_BASE_URL=https://assets-dev.gofurry.com

# Tencent EdgeOne CloudOps
GOFURRY_DEV_EDGEONE_ZONE_ID=<EDGEONE_ZONE_ID>
GOFURRY_DEV_EDGEONE_SECRET_ID=<EDGEONE_SECRET_ID>
GOFURRY_DEV_EDGEONE_SECRET_KEY=<EDGEONE_SECRET_KEY>
GOFURRY_DEV_EDGEONE_MAIN_HOST=go-furry.com
GOFURRY_DEV_EDGEONE_ASSET_HOST=assets-dev.go-furry.com

# Cloudflare CloudOps
GOFURRY_DEV_CLOUDFLARE_ZONE_ID=<CLOUDFLARE_ZONE_ID>
GOFURRY_DEV_CLOUDFLARE_CACHE_TOKEN=<CLOUDFLARE_CACHE_PURGE_TOKEN>
GOFURRY_DEV_CLOUDFLARE_ASSET_HOST=assets-dev.gofurry.com