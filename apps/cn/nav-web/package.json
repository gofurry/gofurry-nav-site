{
  "name": "gofurry-nav-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "assets:test": "node scripts/managed-assets.test.mjs && node scripts/resource-routing.test.mjs && node scripts/hero-preferences.test.mjs",
    "assets:routing-smoke": "node scripts/hero-lifecycle-smoke.mjs && node scripts/resource-routing-smoke.mjs && node scripts/hero-preferences-smoke.mjs",
    "assets:cloud-smoke": "node --env-file=.env scripts/managed-assets-cloud-smoke.mjs",
    "background:smoke": "node scripts/background-storage-smoke.mjs",
    "perf:measure": "node scripts/perf/measure.mjs",
    "perf:guard": "node scripts/perf/guard.mjs",
    "perf:trace": "node scripts/perf/trace.mjs",
    "perf:baseline": "node scripts/perf/measure.mjs --baseline",
    "visual:guard": "node scripts/perf/visual-guard.mjs",
    "insights:smoke": "node scripts/insights-smoke.mjs",
    "game:tags:smoke": "node scripts/game-tag-domain-smoke.mjs",
    "game:tags:test": "node scripts/game-tag-domain.test.mjs",
    "game:detail:smoke": "node scripts/game-detail-smoke.mjs",
    "game:groups:smoke": "node scripts/game-group-layout-smoke.mjs",
    "insights:semantics": "node scripts/insights-semantics.test.mjs",
    "seo:recovery:test": "node scripts/seo-recovery.test.mjs",
    "seo:recovery:smoke": "node scripts/seo-recovery-smoke.mjs",
    "lint": "eslint .",
    "lint:prune": "eslint . --prune-suppressions",
    "stylelint": "stylelint \"app/**/*.{css,less,vue}\"",
    "style:policy": "node scripts/style-policy.mjs",
    "style:policy:test": "node --test scripts/style-policy/*.test.mjs",
    "style:policy:update": "node scripts/style-policy.mjs --update-baseline"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.3.0",
    "@phosphor-icons/vue": "^2.2.1",
    "@pinia/nuxt": "^0.11.3",
    "@tailwindcss/vite": "^4.2.4",
    "@vuepic/vue-datepicker": "^12.1.0",
    "echarts": "^6.0.0",
    "hls.js": "^1.6.16",
    "nuxt": "^4.4.4",
    "pinia": "^3.0.3",
    "tailwindcss": "^4.2.4",
    "vue": "^3.5.21",
    "vue-i18n": "^11.4.0"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "@types/node": "^24.5.2",
    "@vue/compiler-sfc": "3.5.33",
    "eslint": "^10.11.0",
    "less": "^4.6.6",
    "playwright": "^1.60.0",
    "postcss": "^8.5.28",
    "postcss-html": "^2.0.0",
    "postcss-less": "^6.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "typescript": "~5.8.3",
    "vue-tsc": "^3.0.7"
  }
}
